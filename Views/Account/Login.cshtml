@{
    ViewData["Title"] = "ATM Login";
}

<div class="login-container">

    <div class="atm-card">

        <h1>🏦 ATM Banking</h1>

        <p class="subtitle">Secure Customer Login</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Account/Login">

            <div class="form-group">
                <label>Account Number</label>
                <input type="text"
                       name="accountNumber"
                       placeholder="Enter account number"
                       required />
            </div>

            <div class="form-group">
                <label>PIN</label>
                <input type="password"
                       name="pin"
                       placeholder="Enter 4-digit PIN"
                       maxlength="4"
                       required />
            </div>

            <button type="submit">
                Login
            </button>

        </form>

        <p class="demo-info">
            Demo Account<br />
            Account: <strong>100001</strong><br />
            PIN: <strong>1234</strong>
        </p>

    </div>

</div>

<style>
    body {
        background: #f2f5f9;
    }

    .login-container {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .atm-card {
        width: 380px;
        padding: 35px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        text-align: center;
    }

    .atm-card h1 {
        margin-bottom: 5px;
    }

    .subtitle {
        color: #666;
        margin-bottom: 25px;
    }

    .form-group {
        text-align: left;
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: bold;
    }

    .form-group input {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
    }

    button {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        background: #1565c0;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

    button:hover {
        background: #0d47a1;
    }

    .error-message {
        background: #ffebee;
        color: #c62828;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .demo-info {
        margin-top: 25px;
        padding: 12px;
        background: #f5f5f5;
        border-radius: 8px;
        color: #555;
    }
</style>