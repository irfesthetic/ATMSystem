@model List<ATMSystem.Models.Transaction>

@{
    ViewData["Title"] = "Transaction History";
}

<div class="transactions-page">

    <div class="transactions-box">

        <h1>📜 Transaction History</h1>

        @if (Model.Count == 0)
        {
            <p class="no-transactions">
                No transactions found.
            </p>
        }
        else
        {
            <div class="table-container">

                <table>

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Previous Balance</th>
                            <th>New Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var transaction in Model)
                        {
                            <tr>

                                <td>
                                    @transaction.TransactionDate.ToString("dd-MM-yyyy HH:mm")
                                </td>

                                <td>
                                    @transaction.TransactionType
                                </td>

                                <td>
                                    ₹ @transaction.Amount.ToString("N2")
                                </td>

                                <td>
                                    ₹ @transaction.PreviousBalance.ToString("N2")
                                </td>

                                <td>
                                    ₹ @transaction.NewBalance.ToString("N2")
                                </td>

                                <td>
                                    @transaction.Status
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

        <a href="/ATM/Index" class="back-button">
            ← Back to Dashboard
        </a>

    </div>

</div>

<style>

    .transactions-page {
        padding: 40px 20px;
    }

    .transactions-box {
        max-width: 1100px;
        margin: auto;
        padding: 30px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .transactions-box h1 {
        text-align: center;
        margin-bottom: 30px;
    }

    .table-container {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th,
    td {
        padding: 12px;
        text-align: center;
        border-bottom: 1px solid #ddd;
        white-space: nowrap;
    }

    th {
        background: #1565c0;
        color: white;
    }

    tr:hover {
        background: #f5f5f5;
    }

    .no-transactions {
        text-align: center;
        color: #666;
        padding: 30px;
    }

    .back-button {
        display: block;
        width: 200px;
        margin: 25px auto 0;
        padding: 12px;
        text-align: center;
        background: #1565c0;
        color: white;
        text-decoration: none;
        border-radius: 8px;
    }

    .back-button:hover {
        background: #0d47a1;
    }

</style>