@model ATMSystem.Models.Customer

@{
    ViewData["Title"] = "Deposit Money";
}

<div class="deposit-page">

    <div class="deposit-box">

        <h1>💳 Deposit Money</h1>

        <p>Account Holder</p>
        <h2>@Model.FullName</h2>

        <p>Current Balance</p>
        <div class="balance">
            ₹ @Model.Balance.ToString("N2")
        </div>
        @if (ViewBag.Success != null)
        {
            <div class="success-message">
                @ViewBag.Success
            </div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="success-animation">
                <div class="success-icon">✓</div>
                <div>@ViewBag.Success</div>
            </div>
        }

        <form method="post" action="/ATM/DepositMoney">

            <label>Enter Deposit Amount</label>

            <input type="number" name="amount" min="1" step="0.01" placeholder="Enter amount" required />

            <button type="submit">
                💰 Deposit
            </button>

        </form>

        <a href="/ATM/Index" class="back-button">
            ← Back to Dashboard
        </a>

    </div>

</div>

<style>
    .deposit-page {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .deposit-box {
        width: 400px;
        padding: 35px;
        text-align: center;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .deposit-box p {
        color: #666;
        margin-bottom: 5px;
    }

    .balance {
        font-size: 28px;
        font-weight: bold;
        margin: 15px 0 25px;
    }

    .deposit-box label {
        display: block;
        text-align: left;
        margin-bottom: 8px;
        font-weight: bold;
    }

    .deposit-box input {
        width: 100%;
        padding: 12px;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 8px;
        margin-bottom: 15px;
        font-size: 16px;
    }

    .deposit-box button {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 8px;
        background: #1565c0;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

    .deposit-box button:hover {
        background: #0d47a1;
    }

    .back-button {
        display: block;
        margin-top: 15px;
        padding: 12px;
        background: #eee;
        color: #222;
        text-decoration: none;
        border-radius: 8px;
    }
</style>
.success-animation {
    padding: 18px;
    margin-bottom: 20px;
    background: #e8f5e9;
    color: #2e7d32;
    border-radius: 12px;
    font-weight: bold;
    animation: successPop 0.5s ease;
}

.success-icon {
    font-size: 45px;
    margin-bottom: 5px;
    animation: iconBounce 0.6s ease;
}

@@keyframes successPop {
    0% {
        opacity: 0;
        transform: scale(0.7);
    }

    70% {
        transform: scale(1.08);
    }

    100% {
        opacity: 1;
        transform: scale(1);
    }
}

@@keyframes iconBounce {
    0% {
        transform: scale(0);
    }

    60% {
        transform: scale(1.3);
    }

    100% {
        transform: scale(1);
    }
}